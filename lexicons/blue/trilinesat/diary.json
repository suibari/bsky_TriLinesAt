{
  "lexicon": 1,
  "id": "blue.trilinesat.diary",
  "defs": {
    "main": {
      "type": "record",
      "description": "A 3-line diary entry (Three Good Things).",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["lines", "createdAt"],
        "properties": {
          "lines": {
            "type": "array",
            "maxLength": 3,
            "items": { "type": "ref", "ref": "#line" }
          },
          "createdAt": { "type": "string", "format": "datetime" },
          "authorDid": {
            "type": "string",
            "format": "did",
            "description": "Informational only. Clients must use the repo DID as the author."
          },
          "hubRef": {
            "type": "string",
            "format": "at-uri",
            "description": "Fixed backlink target used to aggregate the global feed via Constellation."
          },
          "sharedPost": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef",
            "description": "The app.bsky.feed.post crossposted from this entry."
          },
          "sharedNagiPost": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef",
            "description": "The com.suibari.nagi.post crossposted from this entry."
          }
        }
      }
    },
    "line": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "maxGraphemes": 50, "maxLength": 500 },
        "image": {
          "type": "blob",
          "accept": ["image/*"],
          "maxSize": 1000000
        }
      }
    }
  }
}
